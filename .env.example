# =============================================================================
# Robomuffin Image Factory — environment seed
# Copy to `.env` (installer.bat does this automatically on first install).
# Values here only seed the DB on first run; afterwards edit them in the
# Settings page in the UI.
# =============================================================================

# --- Server ---
FACTORY_HOST=127.0.0.1
FACTORY_PORT=8765
FACTORY_RELOAD=false                 # set true for dev hot-reload

# --- Logging ---
FACTORY_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
FACTORY_LOG_JSON=false               # true = also emit JSON to stdout (machine-parseable)
FACTORY_LOG_RICH=true                # pretty console output via Rich
FACTORY_LOG_RETAIN_DAYS=14           # how long to keep rotated log files

# --- Data dir override (defaults to ./data/) ---
# FACTORY_DATA_DIR=C:\Users\me\Documents\RobomuffinFactory

# --- ComfyUI servers (comma-separated URLs; trailing slash optional) ---
COMFYUI_URLS=http://localhost:8188

# --- LLM providers (all optional; configure later via Settings page) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
DEFAULT_LLM_PROVIDER=                # openai | anthropic | gemini | ollama (blank = auto-pick first available)

# --- Image generation defaults ---
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024
DEFAULT_SEED_MODE=random             # random | fixed
MAX_PARALLEL_PER_WORKER=1
RESTRICT_EXPLICIT_CONTENT=false
